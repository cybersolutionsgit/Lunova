{
  "name": "lunova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "dev:cms": "wrangler pages dev dist --d1 DB --compatibility-date 2026-10-24 --port 8788",
    "db:local": "wrangler d1 execute local-DB --config wrangler.local.jsonc --local --file migrations/0001_cms.sql",
    "build:functions": "wrangler pages functions build --outdir /tmp/lunova-functions-build",
    "build:functions:pages": "npm exec --yes --package wrangler@3.114.17 -- wrangler pages functions build --outdir /tmp/lunova-functions-pages",
    "sketchfab:search": "node scripts/sketchfab-search.mjs",
    "models:import": "node scripts/import-sketchfab.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.182.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  }
}
